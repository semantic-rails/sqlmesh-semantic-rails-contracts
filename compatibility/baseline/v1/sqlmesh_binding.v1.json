{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-rails.com/schemas/sqlmesh_binding.v1.json",
  "title": "SQLMesh Semantic Rails binding (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "binding_version", "packages"],
  "properties": {
    "kind": {
      "const": "sqlmesh"
    },
    "binding_version": {
      "const": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "sqlmesh-semantic-rails-contracts"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/BindingPackage"
      }
    }
  },
  "$defs": {
    "BindingPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "resources"],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted_semantic_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/BindingResource"
          }
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": ["error", "warning"]
        },
        "type_check": {
          "enum": ["ignore", "compatible", "exact"]
        },
        "allow_extra_columns": {
          "type": "boolean"
        },
        "require_owner": {
          "type": "boolean"
        },
        "require_audits": {
          "type": "boolean"
        }
      }
    },
    "BindingResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_model_id", "sqlmesh_model"],
      "properties": {
        "semantic_model_id": {
          "type": "string",
          "minLength": 1
        },
        "sqlmesh_model": {
          "type": "string",
          "minLength": 1
        },
        "sqlmesh_project": {
          "type": "string"
        },
        "sqlmesh_gateway": {
          "type": "string"
        },
        "sqlmesh_kind": {
          "type": "string"
        },
        "sqlmesh_external": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "audits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sqlmesh_catalog": {
          "type": "string"
        },
        "sqlmesh_schema": {
          "type": "string"
        },
        "sqlmesh_identifier": {
          "type": "string"
        },
        "sqlmesh_relation_name": {
          "type": "string"
        },
        "severity": {
          "enum": ["error", "warning"]
        },
        "type_check": {
          "enum": ["ignore", "compatible", "exact"]
        },
        "allow_extra_columns": {
          "type": "boolean"
        }
      }
    }
  }
}
